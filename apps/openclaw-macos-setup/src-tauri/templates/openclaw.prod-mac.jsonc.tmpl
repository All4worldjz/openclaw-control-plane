{
  // Generated by OpenClaw macOS Setup App
  "agents": {
    "defaults": {
      "workspace": "{{OPENCLAW_WORKSPACE_DIR}}",
      "model": {
        "primary": "litellm/coding_primary",
        "fallbacks": ["litellm/balanced_chat", "litellm/fast_chat"]
      },
      "memorySearch": {
        "enabled": true,
        "backend": "qmd"
      }
    }
  },
  "models": {
    "providers": {
      "litellm": {
        "baseUrl": "http://127.0.0.1:4000/v1",
        "apiKey": "{{LITELLM_MASTER_KEY}}",
        "api": "openai-completions",
        "models": [
          {
            "id": "coding_primary",
            "name": "LiteLLM Coding Primary",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 32000,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "balanced_chat",
            "name": "LiteLLM Balanced Chat",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 32000,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          },
          {
            "id": "fast_chat",
            "name": "LiteLLM Fast Chat",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 16000,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
          }
        ]
      }
    }
  },
  "channels": {
    "feishu": {
      "enabled": {{FEISHU_ENABLED}},
      "connectionMode": "websocket",
      "dmPolicy": "pairing",
      "defaultAccount": "main",
      "accounts": {
        "main": {
          "appId": "{{FEISHU_APP_ID}}",
          "appSecret": "{{FEISHU_APP_SECRET}}",
          "botName": "OpenClaw"
        }
      }
    },
    "telegram": {
      "enabled": {{TELEGRAM_ENABLED}},
      "botToken": "{{TELEGRAM_BOT_TOKEN}}",
      "dmPolicy": "pairing",
      "groups": {
        "*": {
          "requireMention": true
        }
      }
    },
    "whatsapp": {
      "enabled": false,
      "allowFrom": []
    }
  },
  "messages": {
    "groupChat": {
      "mentionPatterns": ["@openclaw"]
    }
  },
  "env": {
    "MEM0_API_KEY": "{{MEM0_API_KEY}}",
    "MEM0_API_BASE": "{{MEM0_API_BASE}}",
    "OLLAMA_HOST": "{{OLLAMA_HOST}}",
    "EMBEDDING_MODEL": "{{EMBEDDING_MODEL}}"
  }
}
