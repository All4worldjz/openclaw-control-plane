{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClaw macOS Setup",
  "version": "0.1.0",
  "identifier": "ai.openclaw.macos-setup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenClaw macOS Setup",
        "width": 1380,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
